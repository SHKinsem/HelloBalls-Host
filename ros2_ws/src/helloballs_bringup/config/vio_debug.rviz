Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.45
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: true
      Line Style:
        Line Width: 0.03
        Value: Lines
      Name: Ground Grid
      Plane: XY
      Plane Cell Count: 30
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/TF
      Enabled: true
      Frame Timeout: 15
      Frames:
        All Enabled: true
      Marker Scale: 0.4
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Update Interval: 0
      Value: true
    - Alpha: 1
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 25; 220; 60
      Enabled: true
      Line Style: Lines
      Line Width: 0.04
      Name: VIO Path
      Offset:
        X: 0
        Y: 0
        Z: 0
      Pose Color: 255; 85; 255
      Pose Style: None
      Topic:
        Value: /vio/path
      Value: true
    - Class: rviz_default_plugins/Odometry
      Enabled: true
      Keep: 20
      Name: VIO Odometry
      Position Tolerance: 0.1
      Shape:
        Alpha: 1
        Axes Length: 0.6
        Axes Radius: 0.04
        Color: 255; 85; 0
        Head Length: 0.25
        Head Radius: 0.08
        Shaft Length: 0.45
        Shaft Radius: 0.03
        Value: Axes
      Topic:
        Value: /vio/odometry
      Value: true
    - Alpha: 1
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 10
        Min Value: -10
        Value: true
      Axis: Z
      Channel Name: intensity
      Class: rviz_default_plugins/PointCloud
      Color: 255; 255; 255
      Color Transformer: FlatColor
      Decay Time: 0
      Enabled: true
      Name: VIO Landmarks
      Position Transformer: XYZ
      Queue Size: 10
      Selectable: true
      Size (Pixels): 3
      Size (m): 0.015
      Style: Points
      Topic:
        Value: /vio/point_cloud
      Use Fixed Frame: true
      Value: true
    - Alpha: 1
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 10
        Min Value: -10
        Value: true
      Axis: Z
      Channel Name: intensity
      Class: rviz_default_plugins/PointCloud
      Color: 0; 180; 255
      Color Transformer: FlatColor
      Decay Time: 60
      Enabled: true
      Name: Marginalized Landmarks
      Position Transformer: XYZ
      Queue Size: 10
      Selectable: true
      Size (Pixels): 2
      Size (m): 0.01
      Style: Points
      Topic:
        Value: /vio/margin_cloud
      Use Fixed Frame: true
      Value: true
    - Class: rviz_default_plugins/Marker
      Enabled: true
      Marker Topic:
        Value: /vio/key_poses
      Name: Key Poses
      Queue Size: 100
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Marker Topic:
        Value: /vio/camera_pose_visual
      Name: Camera Pose
      Queue Size: 100
      Value: true
    - Class: rviz_default_plugins/Image
      Enabled: true
      Image Topic:
        Value: /vio/image_track
      Max Value: 1
      Median window: 5
      Min Value: 0
      Name: Feature Track Image
      Normalize Range: true
      Queue Size: 2
      Transport Hint: raw
      Value: true
    - Alpha: 0.35
      Class: rviz_default_plugins/Marker
      Enabled: true
      Marker Topic:
        Value: /court/map_lines
      Name: Court Map Lines
      Queue Size: 10
      Value: true
  Enabled: true
  Global Options:
    Background Color: 20; 20; 24
    Default Light: true
    Fixed Frame: world
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 18
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Name: Current View
      Pitch: 0.8
      Target Frame: world
      Value: Orbit
      Yaw: 0.8
    Saved: ~
Window Geometry:
  Height: 900
  Width: 1440
